# ============================================================================
# Vision RAG — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and never committed.
# ============================================================================

# ── Docker Compose Project Name ──────────────────────────────────────────────
# Controls the prefix for Docker volume names (e.g., "vision_rag_git_hf-cache").
# Set this to match your existing volumes if migrating or updating.
# If your volumes are named "vision_rag_git_hf-cache", set this to "vision_rag_git".
# This ensures docker compose reuses existing volumes instead of creating new ones.
# COMPOSE_PROJECT_NAME=vision_rag_git

# ── VLM Backend (Required for cloud mode) ────────────────────────────────────
# Get a key at https://openrouter.ai/keys
# Required if VLM_PROVIDER is set to "openrouter" (the default).
# Not needed if running local Ollama with a GPU.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# ── LAN Access ───────────────────────────────────────────────────────────────
# Your machine's LAN IP — used so other devices can reach thumbnails and PDFs.
# Find it:
#   Windows:  ipconfig  → look for "IPv4 Address" under your adapter
#   WSL2:     ip route get 1 | awk '{print $7; exit}'
# Leave as "localhost" if you only access from this machine.
HOST_IP=localhost

# ── Confluence Watcher (Optional) ────────────────────────────────────────────
# Generate a PAT: Confluence → Profile → Settings → Personal Access Tokens
CONFLUENCE_PAT=
CONFLUENCE_URL=http://host.docker.internal:8090
CONFLUENCE_SPACES=RAG
CONFLUENCE_POLL_INTERVAL=300

COMPOSE_PROJECT_NAME=vision_rag_git
